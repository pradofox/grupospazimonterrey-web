              <div class="who"><div class="av">I</div><div><b>Sr. Iván G.</b><span>INDUSTRIAL</span></div></div>
            </div>
            <div class="quote">
              <div class="mark">&ldquo;</div>
              <p>Las mismas personas atienden mi empresa y mi casa. 8 años sin ningún problema.</p>
              <div class="who"><div class="av">A</div><div><b>Antonio</b><span>MONTERREY · 8 AÑOS</span></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Cierre -->
  <div class="closing">
    <div class="heart">
      <span class="online"><span class="orb"></span></span> Dirección "Vivo y confiable"
    </div>
    <p class="fin">FIN DEL LAB · grupospazimonterrey.com/lab-vivo · noindex · Manrope + JetBrains Mono</p>
  </div>

  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- reveal-on-scroll ---- */
      var revealables = document.querySelectorAll('.reveal');
      if (reduce) {
        revealables.forEach(function (el) { el.classList.add('in'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
        revealables.forEach(function (el) { io.observe(el); });
      }

      /* ---- texto de entrada palabra por palabra ---- */
      function playWords(container) {
        if (!container) return;
        var words = container.querySelectorAll('.word');
        container.classList.remove('in');
        words.forEach(function (w) { w.style.transitionDelay = ''; });
        // reflow para reiniciar la animacion
        void container.offsetWidth;
        words.forEach(function (w, i) { w.style.transitionDelay = (reduce ? 0 : i * 0.08) + 's'; });
        container.classList.add('in');
      }

      var sigWords = document.getElementById('sigWords');
      var heroWords = document.getElementById('heroWords');

      if (reduce) {
        [sigWords, heroWords].forEach(function (c) { if (c) c.classList.add('in'); });
      } else {
        var wio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { playWords(e.target); wio.unobserve(e.target); }
          });
        }, { threshold: 0.4 });
        if (sigWords) wio.observe(sigWords);
        if (heroWords) wio.observe(heroWords);
      }

      var replay = document.getElementById('replayBtn');
      if (replay) replay.addEventListener('click', function () { playWords(sigWords); });

      /* ---- contadores animados ---- */
      function animateCount(el) {
        var target = parseInt(el.getAttribute('data-count'), 10);
        var plain = el.getAttribute('data-plain') === '1'; // sin separador de miles (años)
        if (reduce) { el.textContent = plain ? String(target) : target.toLocaleString('es-MX'); return; }
        var dur = 1400, start = null;
        function fmt(n) { return plain ? String(n) : n.toLocaleString('es-MX'); }
        function step(ts) {
          if (!start) start = ts;
          var p = Math.min((ts - start) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      var counted = new WeakSet();
      var cio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting && !counted.has(e.target)) {
            counted.add(e.target); animateCount(e.target); cio.unobserve(e.target);
          }
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-count]').forEach(function (el) { cio.observe(el); });

      /* ---- barra de progreso ---- */
      var bio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.style.width = e.target.getAttribute('data-bar') + '%'; bio.unobserve(e.target); }
        });
      }, { threshold: 0.6 });
      document.querySelectorAll('[data-bar]').forEach(function (el) { bio.observe(el); });

      /* ---- boton magnetico ---- */
      if (!reduce && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll('.magnetic').forEach(function (btn) {
          btn.addEventListener('mousemove', function (ev) {
            var r = btn.getBoundingClientRect();
            var mx = ev.clientX - r.left - r.width / 2;
            var my = ev.clientY - r.top - r.height / 2;
            btn.style.transform = 'translate(' + (mx * 0.28) + 'px,' + (my * 0.38) + 'px)';
          });
          btn.addEventListener('mouseleave', function () { btn.style.transform = ''; });
        });
      }
    })();
  </script>

</body>
