---
// LAB de diseño de Grupo Spazi Monterrey - direccion "Vivo y confiable".
// Pagina autocontenida, sin indexar. No comparte estilos con el sitio real.
// Navy vivo + gold calido + acento naranja. Formas redondeadas y generosas,
// nav pildora, grid de fondo, hero con texto que entra animado. Sensacion:
// cercano, energico, humano. El sitio real no se toca hasta aprobar aqui.
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Lab · Vivo y confiable · Grupo Spazi Monterrey</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      /* Vivo y confiable - navy con vida como base, gold calido brillante, naranja acento */
      --navy:      #0C2554;
      --navy-mid:  #1B3A6B;
      --navy-soft: #2C4E86;
      --gold:      #C8A84B;
      --gold-hi:   #E4C15A;
      --orange:    #EC6B2D;
      --orange-so: #F4A46B;
      --cream:     #F7F3EA;
      --paper:     #FBF9F3;
      --ink:       #12203B;
      --muted:     #5C6A80;
      --line:      #E4DECF;
      --white:     #FFFFFF;
      --green:     #2FBF71;
      --green-btn: #128040;  /* verde boton: blanco pasa AA 5.0 */
      --orange-ink:#B4500F;  /* naranja para TEXTO sobre claro: pasa AA 4.9 */

      --r-md: 14px;
      --r-lg: 22px;
      --r-xl: 28px;
      --pill: 100px;
      --maxw: 1140px;
      --ease: cubic-bezier(.2,.8,.2,1);
      --spring: cubic-bezier(.34,1.56,.64,1);
    }

    * , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Manrope', sans-serif;
      background: var(--paper);
      color: var(--ink);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    /* retícula sutil de fondo global */
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(color-mix(in srgb, var(--navy) 5%, transparent) 1px, transparent 1px),
        linear-gradient(90deg, color-mix(in srgb, var(--navy) 5%, transparent) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(ellipse 120% 100% at 50% 0%, #000 30%, transparent 90%);
    }
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 1; }

    ::selection { background: var(--gold-hi); color: var(--navy); }

    /* ---------- Barra superior del lab (pildora flotante) ---------- */
    .lab-bar {
      position: sticky; top: 14px; z-index: 60;
      margin: 14px auto 0; max-width: calc(var(--maxw) + 3rem); padding: 0 1.5rem;
    }
    .lab-bar-inner {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      height: 56px; padding: 0 .6rem 0 1.4rem;
      background: color-mix(in srgb, var(--white) 78%, transparent);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      border: 1px solid color-mix(in srgb, var(--navy) 10%, transparent);
      border-radius: var(--pill);
      box-shadow: 0 12px 40px -18px rgba(12,37,84,.4), inset 0 1px 0 rgba(255,255,255,.7);
    }
    .lab-bar .brand { display: flex; align-items: center; gap: .6rem; }
    .lab-bar .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 4px color-mix(in srgb, var(--orange) 22%, transparent); }
    .lab-bar .tag { font-weight: 800; font-size: .85rem; letter-spacing: -.01em; color: var(--navy); }
    .lab-bar .dir { font-family: 'JetBrains Mono', monospace; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--orange-ink); padding: .28rem .7rem; border-radius: var(--pill); background: color-mix(in srgb, var(--orange) 12%, transparent); }
    .lab-bar .back { display: inline-flex; align-items: center; gap: .4rem; font-weight: 700; font-size: .8rem; color: var(--navy); text-decoration: none; padding: .55rem 1.1rem; border-radius: var(--pill); background: var(--cream); border: 1px solid var(--line); transition: transform .2s var(--ease), background .2s; }
    .lab-bar .back:hover { transform: translateY(-1px); background: var(--gold-hi); }
    .lab-bar .mid { display: flex; align-items: center; gap: .8rem; }
    @media (max-width: 720px) { .lab-bar .dir { display: none; } }

    /* ---------- Estructura del lab ---------- */
    .lab-section { padding: 5rem 0; }
    .lab-section + .lab-section { border-top: 1px solid var(--line); }
    .lab-head { display: flex; align-items: flex-start; gap: 1.1rem; margin-bottom: 2.8rem; }
    .lab-num { font-family: 'JetBrains Mono', monospace; font-size: .74rem; font-weight: 600; color: var(--white); letter-spacing: .04em; background: var(--navy); width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; margin-top: .2rem; }
    .lab-title { font-size: clamp(1.5rem, 3.2vw, 2.1rem); font-weight: 800; letter-spacing: -.025em; line-height: 1.1; color: var(--navy); }
    .lab-note { font-size: .95rem; color: var(--muted); max-width: 62ch; margin-top: .5rem; }

    .mono-label { font-family: 'JetBrains Mono', monospace; font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }

    /* orbe "en linea" reutilizable */
    .online { display: inline-flex; align-items: center; gap: .5rem; font-family: 'JetBrains Mono', monospace; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--navy); }
    .online .orb { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--green); }
    .online .orb::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1.5px solid var(--green); animation: ping 2s var(--ease) infinite; }
    @keyframes ping { 0% { transform: scale(.5); opacity: 1; } 100% { transform: scale(1.6); opacity: 0; } }

    /* ---------- Intro ---------- */
    .kicker { display: inline-flex; align-items: center; gap: .55rem; font-family: 'JetBrains Mono', monospace; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; color: var(--orange-ink); font-weight: 500; }
    .kicker::before { content: ''; width: 26px; height: 2px; border-radius: 2px; background: var(--orange); }
    .intro-title { font-size: clamp(2.6rem, 7vw, 4.6rem); font-weight: 800; line-height: 1; letter-spacing: -.035em; color: var(--navy); margin: 1.1rem 0 .8rem; }
    .intro-title .live { color: var(--orange-ink); position: relative; }
    .intro-lead { font-size: 1.2rem; color: var(--ink); max-width: 60ch; }
    .intro-lead b { color: var(--navy); font-weight: 700; }

    /* ---------- 1. Tokens ---------- */
    .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(158px,1fr)); gap: 1rem; }
    .sw { border-radius: var(--r-lg); overflow: hidden; background: var(--white); border: 1px solid var(--line); box-shadow: 0 8px 22px -18px rgba(12,37,84,.5); transition: transform .25s var(--ease); }
    .sw:hover { transform: translateY(-4px); }
    .sw .chip { height: 84px; display: flex; align-items: flex-end; padding: .5rem .6rem; }
    .sw .chip .role { font-family: 'JetBrains Mono', monospace; font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; padding: .15rem .45rem; border-radius: var(--pill); background: rgba(255,255,255,.7); color: var(--navy); }
    .sw .meta { padding: .7rem .85rem .85rem; }
    .sw .name { font-size: .84rem; font-weight: 700; color: var(--navy); }
    .sw .hex { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--muted); margin-top: .1rem; }

    /* ---------- 2. Tipografia ---------- */
    .type-row { padding: 1.4rem 0; border-top: 1px solid var(--line); }
    .type-row:first-child { border-top: none; }
    .type-tag { font-family: 'JetBrains Mono', monospace; font-size: .66rem; color: var(--orange-ink); letter-spacing: .08em; text-transform: uppercase; margin-bottom: .5rem; }
    .t-d1 { font-size: clamp(2.4rem,6vw,4rem); font-weight: 800; line-height: 1; letter-spacing: -.035em; color: var(--navy); }
    .t-d1 .a { color: var(--orange-ink); }
    .t-d2 { font-size: clamp(1.6rem,3.4vw,2.3rem); font-weight: 700; letter-spacing: -.025em; color: var(--navy); line-height: 1.1; }
    .t-body { font-size: 1.12rem; color: var(--ink); max-width: 64ch; }
    .t-body b { font-weight: 700; color: var(--navy); }
    .t-mono { font-family: 'JetBrains Mono', monospace; font-size: .9rem; color: var(--navy-mid); letter-spacing: .02em; }
    .weights { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: baseline; }
    .weights span { font-size: 1.7rem; color: var(--navy); }

    /* ---------- 3. Firma / distintivo ---------- */
    .sig-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 1.2rem; }
    .sig-card { position: relative; border-radius: var(--r-xl); padding: 1.8rem; overflow: hidden; border: 1px solid var(--line); background: var(--white); }
    .sig-card h4 { font-family: 'JetBrains Mono', monospace; font-size: .66rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin-bottom: 1.2rem; }

    /* firma: hero de texto animado (entra al hacer scroll) */
    .sig-anim { background: var(--navy); color: var(--white); grid-column: 1 / -1; padding: 2.6rem 2.2rem; }
    .sig-anim .grid-bg { position: absolute; inset: 0; background-image: linear-gradient(color-mix(in srgb,#fff 7%,transparent) 1px,transparent 1px), linear-gradient(90deg,color-mix(in srgb,#fff 7%,transparent) 1px,transparent 1px); background-size: 38px 38px; mask-image: radial-gradient(circle at 20% 30%, #000, transparent 75%); }
    .sig-anim h4 { color: color-mix(in srgb,#fff 55%,transparent); position: relative; }
    .sig-anim .line { position: relative; font-size: clamp(1.8rem,4.4vw,3rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.06; overflow: hidden; }
    .sig-anim .line .word { display: inline-block; }
    .sig-anim .line .word.hl { color: var(--gold-hi); }
    /* estado inicial de la animacion de entrada palabra por palabra */
    .reveal-words .word { opacity: 0; transform: translateY(105%) rotate(3deg); transition: opacity .5s var(--ease), transform .7s var(--spring); }
    .reveal-words.in .word { opacity: 1; transform: none; }
    .sig-anim .replay { margin-top: 1.4rem; }

    /* firma: contador */
    .sig-count .big { font-size: 4.2rem; font-weight: 800; letter-spacing: -.04em; color: var(--navy); line-height: .9; }
    .sig-count .big sup { font-size: 1.6rem; color: var(--orange-ink); vertical-align: super; font-weight: 700; }
    .sig-count .cap { margin-top: .6rem; color: var(--muted); font-size: .92rem; }
    .bar { height: 8px; border-radius: var(--pill); background: var(--cream); overflow: hidden; margin-top: 1.2rem; }
    .bar i { display: block; height: 100%; width: 0; border-radius: var(--pill); background: linear-gradient(90deg, var(--gold), var(--orange)); transition: width 1.6s var(--ease); }

    /* firma: orbe grande de estado */
    .sig-orb { display: flex; flex-direction: column; gap: 1.1rem; align-items: flex-start; justify-content: center; }
    .big-orb { position: relative; width: 62px; height: 62px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, var(--gold-hi), var(--gold)); box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 55%, transparent); animation: breathe 3s ease-in-out infinite; }
    @keyframes breathe { 0%,100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 45%, transparent); } 50% { box-shadow: 0 0 0 16px color-mix(in srgb, var(--gold) 0%, transparent); } }
    .sig-orb .txt b { display: block; color: var(--navy); font-weight: 800; font-size: 1.05rem; }
    .sig-orb .txt span { color: var(--muted); font-size: .9rem; }

    /* ---------- 4. Componentes ---------- */
    .comp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); gap: 1.2rem; }
    .demo { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 1.8rem; }
    .demo h4 { font-family: 'JetBrains Mono', monospace; font-size: .66rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin-bottom: 1.3rem; }

    /* botones pildora */
    .btn { display: inline-flex; align-items: center; gap: .55rem; font-family: 'Manrope', sans-serif; font-weight: 700; font-size: .95rem; padding: .85rem 1.6rem; border-radius: var(--pill); border: none; cursor: pointer; text-decoration: none; transition: transform .2s var(--spring), box-shadow .25s var(--ease), background .2s; white-space: nowrap; }
    .btn svg { width: 17px; height: 17px; }
    /* accesibilidad: foco visible por teclado */
    a:focus-visible, button:focus-visible, .btn:focus-visible, .scard:focus-visible { outline: 3px solid var(--orange-ink); outline-offset: 3px; border-radius: 6px; }
    .btn-primary { background: var(--orange); color: var(--ink); box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--orange) 80%, transparent); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 30px -10px color-mix(in srgb, var(--orange) 85%, transparent); }
    .btn-gold { background: var(--gold-hi); color: var(--navy); }
    .btn-gold:hover { transform: translateY(-2px); background: var(--gold); }
    .btn-ghost { background: transparent; color: var(--navy); border: 1.5px solid color-mix(in srgb, var(--navy) 22%, transparent); }
    .btn-ghost:hover { transform: translateY(-2px); border-color: var(--navy); background: var(--cream); }
    .btn-wa { background: var(--green-btn); color: var(--white); }
    .btn-wa:hover { transform: translateY(-2px); box-shadow: 0 14px 26px -12px color-mix(in srgb, var(--green-btn) 80%, transparent); }
    .btn-navy { background: var(--navy); color: var(--white); }
    .btn-navy:hover { transform: translateY(-2px); background: var(--navy-mid); }

    /* boton magnetico */
    .mag-wrap { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; }
    .magnetic { will-change: transform; }

    /* chips de spec en mono */
    .chips { display: flex; flex-wrap: wrap; gap: .6rem; }
    .spec-chip { font-family: 'JetBrains Mono', monospace; font-size: .72rem; padding: .45rem .85rem; border-radius: var(--pill); color: var(--navy-mid); background: var(--cream); border: 1px solid var(--line); display: inline-flex; align-items: center; gap: .45rem; }
    .spec-chip b { color: var(--orange-ink); font-weight: 600; }
    .spec-chip .d { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }

    /* tarjeta de servicio redondeada */
    .scard { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 1.6rem; transition: transform .25s var(--ease), box-shadow .3s var(--ease); cursor: default; }
    .scard:hover { transform: translateY(-6px); box-shadow: 0 22px 40px -22px rgba(12,37,84,.5); }
    .scard .ico { width: 52px; height: 52px; border-radius: var(--r-md); background: color-mix(in srgb, var(--navy) 8%, var(--white)); color: var(--orange); display: grid; place-items: center; margin-bottom: 1.1rem; transition: background .25s, color .25s; }
    .scard:hover .ico { background: var(--navy); color: var(--gold-hi); }
    .scard h5 { font-weight: 800; font-size: 1.2rem; color: var(--navy); margin-bottom: .35rem; letter-spacing: -.01em; }
    .scard p { font-size: .92rem; color: var(--muted); }
    .scard .go { margin-top: 1rem; font-family: 'JetBrains Mono', monospace; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--orange-ink); display: inline-flex; align-items: center; gap: .4rem; }
    .scard .go svg { transition: transform .25s var(--ease); }
    .scard:hover .go svg { transform: translateX(4px); }

    /* fila de stats con contadores */
    .stat-row { display: flex; gap: 2.8rem; flex-wrap: wrap; }
    .stat .n { font-size: 2.9rem; font-weight: 800; line-height: 1; letter-spacing: -.03em; color: var(--navy); }
    .stat .n sup { font-family: 'JetBrains Mono', monospace; font-size: 1rem; color: var(--orange-ink); vertical-align: super; }
    .stat .l { font-family: 'JetBrains Mono', monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-top: .55rem; }

    /* testimonio */
    .quote { background: var(--navy); color: var(--white); border-radius: var(--r-xl); padding: 1.9rem; position: relative; overflow: hidden; }
    .quote .mark { font-size: 4rem; line-height: .6; color: var(--gold-hi); font-weight: 800; opacity: .5; }
    .quote p { font-size: 1.12rem; font-weight: 500; margin: .3rem 0 1.3rem; color: color-mix(in srgb,#fff 92%,transparent); }
    .quote .who { display: flex; align-items: center; gap: .8rem; }
    .quote .av { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--gold-hi), var(--orange)); display: grid; place-items: center; font-weight: 800; color: var(--navy); flex-shrink: 0; }
    .quote .who b { display: block; font-size: .95rem; }
    .quote .who span { font-family: 'JetBrains Mono', monospace; font-size: .66rem; letter-spacing: .06em; color: color-mix(in srgb,#fff 55%,transparent); }

    /* ---------- 5/7. En contexto ---------- */
    .ctx { border: 1px solid var(--line); border-radius: var(--r-xl); overflow: hidden; margin-bottom: 2rem; box-shadow: 0 24px 60px -40px rgba(12,37,84,.6); }
    .ctx-tag { font-family: 'JetBrains Mono', monospace; font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); padding: .7rem 1.2rem; background: var(--cream); border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: .6rem; }

    /* HERO real */
    .hero { position: relative; background: var(--navy); overflow: hidden; padding: 1.4rem; }
    .hero .stage { position: relative; border-radius: var(--r-xl); overflow: hidden; min-height: 560px; display: flex; flex-direction: column; }
    .hero .photo { position: absolute; inset: 0; background-image: linear-gradient(180deg, rgba(12,37,84,.32), rgba(12,37,84,.86)), url('https://images.unsplash.com/photo-1558036117-15d82a90b9b1?w=1400&q=75&auto=format'); background-size: cover; background-position: center; }
    .hero .grid-bg { position: absolute; inset: 0; background-image: linear-gradient(color-mix(in srgb,#fff 7%,transparent) 1px,transparent 1px), linear-gradient(90deg,color-mix(in srgb,#fff 7%,transparent) 1px,transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse 90% 70% at 30% 40%, #000, transparent 80%); }

    /* nav pildora dentro del hero */
    .hero-nav { position: relative; z-index: 3; margin: 1.1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .5rem .6rem .5rem 1.4rem; background: color-mix(in srgb, var(--navy) 55%, transparent); backdrop-filter: blur(14px); border: 1px solid color-mix(in srgb,#fff 14%,transparent); border-radius: var(--pill); }
    .hero-nav .logo { display: flex; align-items: center; gap: .55rem; color: var(--white); font-weight: 800; letter-spacing: -.01em; }
    .hero-nav .logo .g { width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, var(--gold-hi), var(--orange)); display: grid; place-items: center; color: var(--navy); font-size: .8rem; font-weight: 800; }
    .hero-nav .links { display: flex; gap: 1.4rem; }
    .hero-nav .links a { color: color-mix(in srgb,#fff 82%,transparent); text-decoration: none; font-size: .88rem; font-weight: 600; transition: color .2s; }
    .hero-nav .links a:hover { color: var(--gold-hi); }
    .hero-nav .cta { background: var(--orange); color: var(--ink); font-weight: 700; font-size: .85rem; padding: .6rem 1.2rem; border-radius: var(--pill); text-decoration: none; transition: transform .2s var(--spring); }
    .hero-nav .cta:hover { transform: translateY(-2px); }
    @media (max-width: 860px) { .hero-nav .links { display: none; } }

    .hero-body { position: relative; z-index: 2; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding: 2.4rem; }
    .hero-badge { display: inline-flex; align-items: center; gap: .55rem; align-self: flex-start; font-family: 'JetBrains Mono', monospace; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--white); background: color-mix(in srgb,#fff 12%,transparent); border: 1px solid color-mix(in srgb,#fff 18%,transparent); padding: .45rem .9rem; border-radius: var(--pill); margin-bottom: 1.3rem; }
    .hero-badge .orb { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
    .hero-badge .orb::after { content:''; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px solid var(--green); animation: ping 2s var(--ease) infinite; }
    .hero h1 { font-size: clamp(2.4rem, 5.6vw, 4.2rem); font-weight: 800; line-height: 1.02; letter-spacing: -.035em; color: var(--white); max-width: 16ch; margin-bottom: 1.2rem; }
    .hero h1 .word { display: inline-block; }
    .hero h1 .a { color: var(--gold-hi); }
    .hero p { color: color-mix(in srgb,#fff 82%,transparent); font-size: 1.15rem; max-width: 46ch; margin-bottom: 1.8rem; }
    .hero .actions { display: flex; gap: .8rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .hero .metrics { display: flex; gap: 2.4rem; flex-wrap: wrap; padding-top: 1.5rem; border-top: 1px solid color-mix(in srgb,#fff 16%,transparent); }
    .hero .metrics .n { font-size: 2.1rem; font-weight: 800; color: var(--white); line-height: 1; letter-spacing: -.03em; }
    .hero .metrics .n sup { font-size: .9rem; color: var(--gold-hi); }
    .hero .metrics .l { font-family: 'JetBrains Mono', monospace; font-size: .64rem; text-transform: uppercase; letter-spacing: .08em; color: color-mix(in srgb,#fff 60%,transparent); margin-top: .4rem; }

    /* marquee de servicios */
    .marquee { position: relative; z-index: 2; overflow: hidden; background: var(--orange); border-radius: 0; }
    .marquee .track { display: flex; gap: 2.2rem; padding: .7rem 0; white-space: nowrap; width: max-content; animation: slide 26s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
    .marquee span { font-family: 'JetBrains Mono', monospace; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--navy); display: inline-flex; align-items: center; gap: 2.2rem; }
    .marquee span::after { content: '◆'; color: color-mix(in srgb, var(--navy) 55%, transparent); font-size: .6rem; }
    @keyframes slide { to { transform: translateX(-50%); } }

    /* banda de servicios (segunda seccion real) */
    .band { background: var(--cream); border-radius: var(--r-xl); padding: 2.6rem; }
    .band-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
    .band-head h2 { font-size: clamp(1.7rem,3.4vw,2.4rem); font-weight: 800; letter-spacing: -.03em; color: var(--navy); line-height: 1.05; max-width: 18ch; }
    .band-head p { color: var(--muted); font-size: .95rem; max-width: 32ch; }
    .band-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 1.1rem; }

    /* banda de testimonios */
    .tband { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 1.1rem; }

    /* reveal on scroll */
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity .6s var(--ease), transform .7s var(--ease); }
    .reveal.in { opacity: 1; transform: none; }

    /* cierre */
    .closing { text-align: center; padding: 3rem 1.5rem 4.5rem; }
    .closing .fin { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--muted); letter-spacing: .06em; }
    .closing .heart { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 1rem; font-weight: 700; color: var(--navy); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .reveal, .reveal-words .word { opacity: 1 !important; transform: none !important; }
    }

    @media (max-width: 640px) {
      .lab-section { padding: 3.5rem 0; }
      .hero-body { padding: 1.6rem; }
      .hero .metrics { gap: 1.6rem; }
      .stat-row { gap: 1.8rem; }
      .band { padding: 1.8rem; }
    }
  </style>
</head>
