---
// Galeria del lab de diseño de Grupo Spazi Monterrey.
// Enlaza las 4 direcciones exploradas. Sin indexar. No toca el sitio real.
const dirs = [
  { slug: 'lab-nocturno', n: '01', name: 'Nocturno refinado', desc: 'Navy protagonista, premium y sobrio tipo Linear. Glassmorphism, glow de gold y naranja sobre la oscuridad. Ingeniería seria y cara.', bg: '#0A1B3D', fg: '#F7F3EA', accent: '#E4C15A' },
  { slug: 'lab-vivo', n: '02', name: 'Vivo y confiable', desc: 'Navy con vida + amarillo cálido + naranja. Formas redondeadas, grid sutil, texto animado. Cercano, "esta empresa sí contesta".', bg: '#123A7A', fg: '#FFFFFF', accent: '#F5CA2F' },
  { slug: 'lab-claro', n: '03', name: 'Claro y nítido', desc: 'Base clara con mucho aire, tipo SaaS premium. Navy para texto, naranja para el CTA. Moderno, ordenado, de confianza.', bg: '#FBF9F3', fg: '#12203B', accent: '#EC6B2D' },
  { slug: 'lab-editorial', n: '04', name: 'Editorial de obra', desc: 'Fotografía dramática full-bleed, titulares enormes, specs técnicas en mono. Robusta, premium industrial, "hacemos obra de verdad".', bg: '#12203B', fg: '#F7F3EA', accent: '#EC6B2D' },
];
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Lab de diseño · Grupo Spazi Monterrey</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
    :root { --navy:#0C2554; --gold:#C8A84B; --orange:#EC6B2D; --paper:#FBF9F3; --ink:#12203B; --muted:#5C6A80; --line:#E4DECF; }
    body { font-family:'Manrope',sans-serif; background:var(--paper); color:var(--ink); line-height:1.6; -webkit-font-smoothing:antialiased; }
    .wrap { max-width:1080px; margin:0 auto; padding:0 1.5rem; }
    .top { padding:4.5rem 0 2.5rem; }
    .kick { font-family:'JetBrains Mono',monospace; font-size:.72rem; letter-spacing:.16em; text-transform:uppercase; color:var(--orange); display:inline-flex; align-items:center; gap:.5rem; }
    .kick::before { content:''; width:22px; height:1.5px; background:var(--orange); }
    h1 { font-size:clamp(2.2rem,5vw,3.4rem); font-weight:800; letter-spacing:-.03em; line-height:1.05; margin:1rem 0 .8rem; }
    h1 em { font-style:normal; color:var(--gold); }
    .lead { font-size:1.08rem; color:var(--muted); max-width:64ch; }
    .note { font-family:'JetBrains Mono',monospace; font-size:.72rem; color:var(--muted); margin-top:1.2rem; letter-spacing:.03em; }
    .grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.4rem; padding:1rem 0 5rem; }
    @media (max-width:720px){ .grid{ grid-template-columns:1fr; } }
    .card { display:block; text-decoration:none; color:inherit; border:1px solid var(--line); border-radius:20px; overflow:hidden; background:#fff; transition:transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s; }
    .card:hover { transform:translateY(-6px); box-shadow:0 22px 50px rgba(12,37,84,.16); }
    .card .prev { height:190px; display:flex; align-items:flex-end; padding:1.3rem; position:relative; overflow:hidden; }
    .card .prev::after { content:''; position:absolute; inset:0; background-image:linear-gradient(currentColor 1px,transparent 1px),linear-gradient(90deg,currentColor 1px,transparent 1px); background-size:26px 26px; opacity:.10; }
    .card .num { font-family:'JetBrains Mono',monospace; font-size:.8rem; letter-spacing:.1em; position:relative; z-index:1; opacity:.85; }
    .card .body { padding:1.3rem 1.4rem 1.5rem; }
    .card h2 { font-size:1.3rem; font-weight:700; letter-spacing:-.01em; margin-bottom:.4rem; }
    .card p { font-size:.92rem; color:var(--muted); }
    .card .go { display:inline-flex; align-items:center; gap:.4rem; margin-top:1rem; font-family:'JetBrains Mono',monospace; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--orange); }
    .card:hover .go { gap:.7rem; }
  </style>
</head>
<body>
  <div class="wrap top">
    <span class="kick">Dirección de diseño · Spazi</span>
    <h1>Cuatro caminos para <em>rediseñar</em> Spazi</h1>
    <p class="lead">Cada tarjeta es un lab completo: tokens, tipografía, componentes y el sitio en contexto. Misma marca (navy + gold + un buen naranja de acento), misma tipografía (Manrope), misma base de contenido. Cambia el carácter. Ábrelos, compáralos, y elige por cuál seguimos.</p>
    <p class="note">Sin indexar · fotos de placeholder (Unsplash) · el sitio real no se toca hasta elegir</p>
  </div>
  <div class="wrap">
    <div class="grid">
      {dirs.map(d => (
        <a class="card" href={`/${d.slug}`}>
          <div class="prev" style={`background:${d.bg}; color:${d.accent}`}>
            <span class="num" style={`color:${d.fg}`}>{d.n} · <span style={`color:${d.accent}`}>{d.name}</span></span>
          </div>
          <div class="body">
            <h2>{d.name}</h2>
            <p>{d.desc}</p>
            <span class="go">Ver lab →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</body>
</html>
