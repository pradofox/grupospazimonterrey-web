---
// LAB de diseño de Grupo Spazi Monterrey - direccion "Claro y nitido".
// Base clara estilo SaaS premium (Manrope + JetBrains Mono).
// Autocontenida, sin indexar. No comparte estilos con el sitio real.
// El sitio real no se toca hasta que Roberto apruebe una direccion.
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Lab · Claro y nítido · Grupo Spazi Monterrey</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      /* Paleta Spazi viva - navy + gold mandan, naranja es acento */
      --navy:      #0C2554;
      --navy-mid:  #1B3A6B;
      --gold:      #C8A84B;
      --gold-hi:   #E4C15A;
      --orange:    #EC6B2D;
      --orange-soft:#F4A46B;
      --cream:     #F7F3EA;
      --paper:     #FBF9F3;
      --ink:       #12203B;
      --muted:     #5C6A80;
      --line:      #E4DECF;
      --line-soft: #EFEADD;
      --white:     #FFFFFF;
      --online:    #2FBF71;

      /* Sombras muy suaves, deferencia HIG */
      --sh-xs: 0 1px 2px rgba(12,37,84,.05);
      --sh-sm: 0 4px 14px rgba(12,37,84,.06);
      --sh-md: 0 12px 34px rgba(12,37,84,.09);
      --sh-lg: 0 26px 60px rgba(12,37,84,.13);

      --r-sm: 8px;
      --r-md: 12px;
      --r-lg: 16px;
      --r-xl: 22px;
      --maxw: 1140px;
      --ease: cubic-bezier(.22,.7,.24,1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Manrope', sans-serif;
      background: var(--paper);
      color: var(--ink);
      line-height: 1.62;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 1.6rem; }
    ::selection { background: var(--orange-soft); color: var(--navy); }

    /* ---------- Barra del lab ---------- */
    .lab-bar {
      position: sticky; top: 0; z-index: 60;
      background: color-mix(in srgb, var(--paper) 82%, transparent);
      backdrop-filter: saturate(140%) blur(14px);
      border-bottom: 1px solid var(--line);
    }
    .lab-bar-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; gap: 1rem; }
    .lab-bar .brand { display: flex; align-items: center; gap: .7rem; }
    .lab-bar .brand .tag { font-family: 'JetBrains Mono', monospace; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--navy); font-weight: 600; }
    .lab-bar .brand .dir { font-family: 'JetBrains Mono', monospace; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--orange); border: 1px solid color-mix(in srgb, var(--orange) 40%, var(--line)); padding: .18rem .5rem; border-radius: 100px; }
    .lab-bar a.back { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--muted); text-decoration: none; letter-spacing: .03em; transition: color .2s var(--ease); }
    .lab-bar a.back:hover { color: var(--navy); }

    /* ---------- Estructura ---------- */
    .lab-section { padding: 5rem 0; border-bottom: 1px solid var(--line-soft); }
    .lab-head { display: flex; align-items: baseline; gap: 1.1rem; margin-bottom: 2.6rem; }
    .lab-num { font-family: 'JetBrains Mono', monospace; font-size: .74rem; color: var(--orange); letter-spacing: .12em; padding-top: .35rem; }
    .lab-title { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 700; letter-spacing: -.02em; color: var(--navy); }
    .lab-note { font-size: .95rem; color: var(--muted); max-width: 64ch; margin-top: .5rem; }

    .mono-label { font-family: 'JetBrains Mono', monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }

    /* ---------- Intro ---------- */
    .intro { padding: 4rem 0 4.5rem; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: .55rem;
      font-family: 'JetBrains Mono', monospace; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase;
      color: var(--navy-mid); background: var(--white); border: 1px solid var(--line);
      padding: .4rem .8rem; border-radius: 100px; box-shadow: var(--sh-xs);
    }
    .eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); }
    .intro h1 { font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 800; line-height: 1.02; letter-spacing: -.035em; color: var(--navy); margin: 1.3rem 0 .8rem; }
    .intro h1 .accent { color: var(--orange); }
    .intro p.thesis { font-size: 1.18rem; color: var(--ink); max-width: 60ch; }
    .intro p.thesis b { font-weight: 700; }

    /* ---------- Badge con orbe (motivo reutilizable) ---------- */
    .pill-online {
      display: inline-flex; align-items: center; gap: .6rem;
      background: var(--white); border: 1px solid var(--line);
      padding: .5rem .9rem .5rem .75rem; border-radius: 100px; box-shadow: var(--sh-sm);
      font-size: .84rem; font-weight: 600; color: var(--navy);
    }
    .orb { position: relative; width: 10px; height: 10px; flex: none; }
    .orb i { position: absolute; inset: 0; border-radius: 50%; background: var(--online); }
    .orb::before {
      content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--online);
      animation: orbPulse 2.4s var(--ease) infinite;
    }
    @keyframes orbPulse { 0% { transform: scale(1); opacity: .55; } 70%,100% { transform: scale(2.8); opacity: 0; } }
    .pill-online .sep { color: var(--line); }
    .pill-online .muted { color: var(--muted); font-weight: 500; }

    /* ---------- 1. Tokens ---------- */
    .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px,1fr)); gap: .85rem; }
    .sw { border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; background: var(--white); box-shadow: var(--sh-xs); transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
    .sw:hover { transform: translateY(-3px); box-shadow: var(--sh-sm); }
    .sw .chip { height: 78px; }
    .sw .meta { padding: .6rem .75rem; }
    .sw .name { font-size: .82rem; font-weight: 700; color: var(--navy); }
    .sw .hex { font-family: 'JetBrains Mono', monospace; font-size: .7rem; color: var(--muted); margin-top: .1rem; }

    /* ---------- 2. Tipografia ---------- */
    .type-row { padding: 1.3rem 0; border-top: 1px solid var(--line-soft); }
    .type-row:first-child { border-top: none; padding-top: 0; }
    .type-row .type-label { margin-bottom: .55rem; }
    .t-display { font-size: clamp(2.2rem,5.5vw,3.6rem); font-weight: 800; line-height: 1.02; letter-spacing: -.035em; color: var(--navy); }
    .t-display .accent { color: var(--orange); }
    .t-h2 { font-size: 1.9rem; font-weight: 700; letter-spacing: -.02em; color: var(--navy); }
    .t-body { font-size: 1.1rem; color: var(--ink); max-width: 62ch; }
    .t-mono { font-family: 'JetBrains Mono', monospace; font-size: .86rem; color: var(--navy-mid); letter-spacing: .01em; }
    .weights { display: flex; flex-wrap: wrap; gap: 1.4rem; align-items: baseline; }
    .weights span { font-size: 1.5rem; color: var(--navy); }

    /* ---------- 3. Firma: consola de estado viva ---------- */
    .console {
      background: var(--white); border: 1px solid var(--line); border-radius: var(--r-xl);
      box-shadow: var(--sh-md); overflow: hidden;
    }
    .console-top { display: flex; align-items: center; gap: .8rem; padding: .85rem 1.1rem; border-bottom: 1px solid var(--line-soft); background: color-mix(in srgb, var(--cream) 55%, var(--white)); }
    .traffic { display: flex; gap: .4rem; }
    .traffic i { width: 11px; height: 11px; border-radius: 50%; display: block; }
    .traffic i:nth-child(1) { background: #F0685E; }
    .traffic i:nth-child(2) { background: #F5C04E; }
    .traffic i:nth-child(3) { background: var(--online); }
    .console-top .path { font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--muted); }
    .console-body { display: grid; grid-template-columns: 1.15fr .85fr; }
    .console-scene { position: relative; padding: 2rem; min-height: 260px; background:
      radial-gradient(120% 120% at 20% 0%, color-mix(in srgb, var(--navy) 5%, var(--white)) 0%, var(--white) 55%);
      border-right: 1px solid var(--line-soft); }
    .console-scene .field {
      position: absolute; inset: 1.4rem;
      background-image:
        linear-gradient(color-mix(in srgb, var(--navy) 7%, transparent) 1px, transparent 1px),
        linear-gradient(90deg, color-mix(in srgb, var(--navy) 7%, transparent) 1px, transparent 1px);
      background-size: 26px 26px;
      mask-image: radial-gradient(circle at 50% 55%, #000 60%, transparent 100%);
      border-radius: var(--r-md);
    }
    .console-scene svg { position: relative; width: 100%; height: 220px; display: block; }
    .gate-line { stroke: var(--navy); stroke-width: 2; fill: none; }
    .gate-line.draw { stroke-dasharray: 460; stroke-dashoffset: 460; animation: draw 2.6s var(--ease) .2s forwards; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .gate-panel { fill: color-mix(in srgb, var(--gold) 22%, var(--white)); stroke: var(--gold); stroke-width: 1.5; }
    .node { fill: var(--orange); }
    .node.pulse { animation: nodePulse 2.2s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
    @keyframes nodePulse { 0%,100% { opacity: .35; } 50% { opacity: 1; } }
    .sweep {
      position: absolute; top: 1.4rem; bottom: 1.4rem; left: 1.4rem; width: 34%;
      background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--orange) 12%, transparent));
      border-radius: 40%; animation: sweep 4.2s var(--ease) infinite; pointer-events: none;
    }
    @keyframes sweep { 0%,100% { transform: translateX(0); } 50% { transform: translateX(190%); } }
    .n-tag { fill: var(--navy-mid); font-family: 'JetBrains Mono', monospace; font-size: 8.5px; letter-spacing: .08em; }

    .console-side { padding: 1.6rem; display: flex; flex-direction: column; gap: 1.1rem; }
    .stat-live { border: 1px solid var(--line-soft); border-radius: var(--r-md); padding: 1rem 1.1rem; background: var(--paper); }
    .stat-live .k { font-family: 'JetBrains Mono', monospace; font-size: .64rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
    .stat-live .v { font-size: 2rem; font-weight: 800; color: var(--navy); line-height: 1; margin-top: .3rem; letter-spacing: -.02em; }
    .stat-live .v sup { font-size: .95rem; color: var(--orange); font-weight: 700; }
    .status-line { display: flex; align-items: center; gap: .55rem; font-family: 'JetBrains Mono', monospace; font-size: .72rem; color: var(--navy); letter-spacing: .04em; }

    .micro-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 1rem; margin-top: 1.4rem; }
    .micro { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-md); padding: 1.2rem; box-shadow: var(--sh-xs); }
    .micro h4 { font-family: 'JetBrains Mono', monospace; font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .9rem; }
    .lift-demo { display: inline-flex; align-items: center; gap: .6rem; padding: .75rem 1rem; border-radius: var(--r-md); background: var(--navy); color: var(--white); font-weight: 600; font-size: .9rem; box-shadow: var(--sh-sm); transition: transform .28s var(--ease), box-shadow .28s var(--ease); cursor: default; }
    .lift-demo:hover { transform: translateY(-5px); box-shadow: var(--sh-md); }
    .counter-big { font-size: 2.6rem; font-weight: 800; color: var(--navy); letter-spacing: -.02em; line-height: 1; }
    .counter-big sup { font-size: 1.1rem; color: var(--orange); }

    /* ---------- 4. Componentes ---------- */
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); gap: 1.3rem; }
    .demo { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.7rem; box-shadow: var(--sh-xs); }
    .demo h4 { font-family: 'JetBrains Mono', monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 1.1rem; }

    .btn { display: inline-flex; align-items: center; gap: .55rem; font-family: 'Manrope', sans-serif; font-weight: 700; font-size: .94rem; padding: .82rem 1.5rem; border-radius: var(--r-md); border: 1px solid transparent; cursor: pointer; text-decoration: none; transition: transform .22s var(--ease), box-shadow .22s var(--ease), background .2s var(--ease); }
    .btn svg { width: 17px; height: 17px; }
    .btn-primary { background: var(--orange); color: var(--white); box-shadow: 0 8px 20px rgba(236,107,45,.28); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(236,107,45,.34); background: #F0782F; }
    .btn-navy { background: var(--navy); color: var(--white); }
    .btn-navy:hover { transform: translateY(-2px); box-shadow: var(--sh-md); background: var(--navy-mid); }
    .btn-ghost { background: var(--white); color: var(--navy); border-color: var(--line); }
    .btn-ghost:hover { transform: translateY(-2px); border-color: var(--gold); box-shadow: var(--sh-sm); }
    .btn-wa { background: #25D366; color: #06351A; }
    .btn-wa:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(37,211,102,.3); }

    .chips { display: flex; flex-wrap: wrap; gap: .55rem; }
    .spec-chip { display: inline-flex; align-items: center; gap: .45rem; font-family: 'JetBrains Mono', monospace; font-size: .7rem; padding: .38rem .75rem; border: 1px solid var(--line); border-radius: 100px; color: var(--navy-mid); background: var(--paper); letter-spacing: .03em; }
    .spec-chip b { color: var(--orange); font-weight: 600; }
    .spec-chip .d { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }

    .scard { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.5rem; box-shadow: var(--sh-xs); transition: transform .28s var(--ease), box-shadow .28s var(--ease); }
    .scard:hover { transform: translateY(-5px); box-shadow: var(--sh-md); }
    .scard .ico { width: 46px; height: 46px; border-radius: var(--r-md); background: color-mix(in srgb, var(--navy) 8%, var(--white)); color: var(--navy); display: grid; place-items: center; margin-bottom: 1rem; }
    .scard:hover .ico { background: var(--orange); color: var(--white); transition: background .25s var(--ease), color .25s var(--ease); }
    .scard h5 { font-weight: 700; font-size: 1.14rem; color: var(--navy); margin-bottom: .35rem; letter-spacing: -.01em; }
    .scard p { font-size: .92rem; color: var(--muted); }

    .stat { display: flex; flex-direction: column; }
    .stat .n { font-size: 2.7rem; font-weight: 800; line-height: 1; color: var(--navy); letter-spacing: -.03em; }
    .stat .n sup { font-family: 'JetBrains Mono', monospace; font-size: .95rem; color: var(--orange); vertical-align: super; font-weight: 600; }
    .stat .l { font-family: 'JetBrains Mono', monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-top: .55rem; }
    .stat-row { display: flex; gap: 2.8rem; flex-wrap: wrap; }

    .quote { background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.7rem; box-shadow: var(--sh-xs); }
    .quote .stars { color: var(--gold); font-size: .9rem; letter-spacing: .15em; margin-bottom: .8rem; }
    .quote p { font-size: 1.06rem; color: var(--ink); margin-bottom: 1.2rem; font-weight: 500; }
    .quote .who { display: flex; align-items: center; gap: .75rem; }
    .quote .who .av { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--navy), var(--navy-mid)); color: var(--gold-hi); display: grid; place-items: center; font-weight: 700; font-size: .95rem; flex: none; }
    .quote .who b { font-size: .92rem; color: var(--navy); display: block; }
    .quote .who span { font-family: 'JetBrains Mono', monospace; font-size: .66rem; color: var(--muted); letter-spacing: .05em; }

    /* ---------- 5. En contexto: HERO ---------- */
    .ctx { border: 1px solid var(--line); border-radius: var(--r-xl); overflow: hidden; margin-bottom: 2.2rem; box-shadow: var(--sh-sm); }
    .ctx-tag { font-family: 'JetBrains Mono', monospace; font-size: .66rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); padding: .65rem 1.1rem; background: var(--cream); border-bottom: 1px solid var(--line); }

    .hero { position: relative; background:
      radial-gradient(130% 90% at 85% -10%, color-mix(in srgb, var(--gold) 14%, var(--paper)) 0%, var(--paper) 45%),
      var(--paper);
      padding: 4rem 3rem; display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: center; overflow: hidden; }
    .hero .dots { position: absolute; inset: 0; background-image: radial-gradient(color-mix(in srgb, var(--navy) 7%, transparent) 1.2px, transparent 1.2px); background-size: 22px 22px; mask-image: radial-gradient(circle at 90% 0%, #000, transparent 55%); pointer-events: none; }
    .hero-copy { position: relative; }
    .hero h1 { font-size: clamp(2.1rem, 4.2vw, 3.4rem); font-weight: 800; line-height: 1.03; letter-spacing: -.035em; color: var(--navy); margin: 1.3rem 0 1.1rem; }
    .hero h1 .accent { color: var(--orange); }
    .hero p.sub { font-size: 1.1rem; color: var(--ink); max-width: 44ch; margin-bottom: 1.8rem; }
    .hero .actions { display: flex; gap: .8rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .hero .trust { display: flex; gap: 2.4rem; padding-top: 1.6rem; border-top: 1px solid var(--line); }

    /* mockup chrome de la foto (estilo SaaS mostrando su app) */
    .shot { position: relative; }
    .shot-frame { position: relative; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-lg); overflow: hidden; }
    .shot-bar { display: flex; align-items: center; gap: .8rem; padding: .7rem .9rem; border-bottom: 1px solid var(--line-soft); background: color-mix(in srgb, var(--cream) 50%, var(--white)); }
    .shot-bar .traffic i { width: 10px; height: 10px; }
    .shot-bar .url { font-family: 'JetBrains Mono', monospace; font-size: .66rem; color: var(--muted); background: var(--paper); padding: .2rem .6rem; border-radius: 100px; border: 1px solid var(--line-soft); }
    .shot-img { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--cream); }
    .shot-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .shot-img .grad { position: absolute; inset: 0; background: linear-gradient(200deg, transparent 55%, rgba(12,37,84,.28)); }

    /* tarjetas flotantes sobre la foto */
    .float-card { position: absolute; background: var(--white); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--sh-md); padding: .7rem .9rem; display: flex; align-items: center; gap: .6rem; font-size: .8rem; font-weight: 600; color: var(--navy); }
    .float-card .fi { width: 30px; height: 30px; border-radius: var(--r-sm); display: grid; place-items: center; flex: none; }
    .float-a { top: -18px; left: -22px; animation: floaty 5s ease-in-out infinite; }
    .float-b { bottom: 20px; right: -26px; animation: floaty 5.6s ease-in-out .6s infinite; }
    @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
    .float-card small { display: block; font-family: 'JetBrains Mono', monospace; font-size: .6rem; color: var(--muted); font-weight: 500; letter-spacing: .04em; }

    /* Segunda seccion real: grid de servicios */
    .services-band { background: var(--white); padding: 3.2rem 2.5rem; }
    .services-band .band-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .services-band h2 { font-size: clamp(1.6rem,3vw,2.2rem); font-weight: 800; letter-spacing: -.025em; color: var(--navy); }
    .services-band h2 .accent { color: var(--orange); }
    .services-band .band-head p { color: var(--muted); max-width: 40ch; font-size: .95rem; }
    .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); gap: 1.2rem; }

    /* Banda de testimonios */
    .tband { background: var(--navy); padding: 3.2rem 2.5rem; position: relative; overflow: hidden; }
    .tband .glow { position: absolute; inset: 0; background: radial-gradient(60% 80% at 15% 0%, rgba(200,168,75,.16), transparent 60%); pointer-events: none; }
    .tband .band-head { position: relative; margin-bottom: 2rem; }
    .tband .band-head .mono-label { color: var(--gold-hi); }
    .tband h2 { position: relative; font-size: clamp(1.6rem,3vw,2.2rem); font-weight: 800; letter-spacing: -.025em; color: var(--white); margin-top: .5rem; }
    .tgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 1.2rem; position: relative; }
    .tcard { background: color-mix(in srgb, var(--navy-mid) 55%, var(--navy)); border: 1px solid rgba(200,168,75,.22); border-radius: var(--r-lg); padding: 1.5rem; }
    .tcard .stars { color: var(--gold-hi); font-size: .85rem; letter-spacing: .15em; margin-bottom: .8rem; }
    .tcard p { color: rgba(255,255,255,.9); font-size: .98rem; margin-bottom: 1.2rem; font-weight: 500; }
    .tcard .who b { color: var(--white); font-size: .9rem; display: block; }
    .tcard .who span { font-family: 'JetBrains Mono', monospace; font-size: .64rem; color: var(--gold-hi); letter-spacing: .05em; }

    /* ---------- Reveal on scroll ---------- */
