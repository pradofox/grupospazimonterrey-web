---
const services = [
  {
    title: 'Automatizacion de Portones',
    desc: 'Motores axiales, cremallera, cadena y pistones. Instalacion, programacion y mantenimiento. Compatible con todos los sistemas.',
    icon: `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="28" height="28"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/><path d="M7 8l5 3 5-3"/></svg>`,
  },
  {
    title: 'Control de Accesos',
    desc: 'Tarjetas, biometricos, teclados y apps. Gestion de usuarios y registros para residencias, condominios y plantas industriales.',
    icon: `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="28" height="28"><path d="M15 3H7a2 2 0 00-2 2v14a2 2 0 002 2h8"/><path d="M9 3v18"/><path d="M13 7h4m-4 4h4m-4 4h4"/></svg>`,
  },
  {
    title: 'Camaras y CCTV',
    desc: 'Sistemas de videovigilancia HD con acceso remoto desde tu celular. Vision a color en la noche. Para casas, negocios y parques industriales.',
    icon: `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="28" height="28"><path d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.892L15 14"/><rect x="1" y="6" width="15" height="12" rx="2"/></svg>`,
  },
  {
    title: 'Alarmas y Seguridad',
    desc: 'Sensores de movimiento, contactos magneticos y paneles de alarma. Monitoreo 24/7 y notificaciones en tiempo real.',
    icon: `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="28" height="28"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: 'Herreria y Fabricacion',
    desc: 'Portones, rejas, barandales y puertas a medida. Coordinamos con herreros de confianza para entregarte el proyecto llave en mano.',
    icon: `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="28" height="28"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
  },
  {
    title: 'Gestion de Proyectos',
    desc: 'Coordinamos herreros, instaladores y proveedores. Tu tienes un solo interlocutor. Presupuesto, calendario y seguimiento.',
    icon: `<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="28" height="28"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>`,
  },
];
---
<section id="servicios">
  <div class="container">
    <div class="section-header">
      <div class="tag">Lo que hacemos</div>
      <h2 class="section-title">Soluciones integrales<br>de acceso y seguridad</h2>
      <p class="section-sub">No solo vendemos el motor - gestionamos el proyecto completo, desde la visita tecnica hasta el soporte post-instalacion.</p>
    </div>
    <div class="services-grid">
      {services.map((s, i) => (
        <div class={`service-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
          <div class="service-icon" set:html={s.icon} />
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
