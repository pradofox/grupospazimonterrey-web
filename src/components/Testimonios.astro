---
// Testimonios reales grabados por clientes de Grupo Spazi Monterrey
const featured = {
  quote: 'Las mismas personas atienden tanto mi empresa como mi casa: motores, cámaras, herrería, pintura, control de accesos y cortina de acero. Ya tenemos 8 años trabajando sin ningún problema.',
  name: 'Antonio',
  meta: 'Monterrey - empresa y residencia',
  service: 'Cliente 8 años',
};

// TEMPORAL (2026-05-18): testimonio destacado del Patronato de Bomberos NL
// movido para no exponerlo previo a una junta con ellos. Mientras tanto se
// destaca a Sr. Ivan G. (industrial real, ya estaba en el grid).
// Para RESTAURAR el de Bomberos: quitar el const `highlight` de abajo, restaurar
// `bomberos` con el bloque comentado mas abajo, volver el JSX a {bomberos.X},
// y reponer Sr. Ivan G. en el array `cards`.
//
// const bomberos = {
//   quote: 'Nos han dado servicio por más de 7 años en todas las estaciones. Estamos muy contentos con la rapidez y lo bien hecho del servicio. El motor de cortina de acero nos gustó tanto que quisiéramos uno igual en todas.',
//   name: 'Patronato de Bomberos de Nuevo León',
//   meta: '4 estaciones atendidas',
//   service: 'Industrial - 7+ años',
// };

const highlight = {
  quote: 'Está muy cómodo el control remoto para usarlo desde el montacargas, muy seguro y muy rápido. Ayuda a que no se salga el aire acondicionado de la planta y a que el manejo sea cómodo y eficiente.',
  name: 'Sr. Iván G.',
  meta: 'Zona industrial, Monterrey',
  service: 'Portón ascendente industrial',
};

const cards = [
  {
    quote: 'Abre rápido, me siento muy seguro. El control es comodísimo, incluso llegando en moto. No hace ruido, no se ve hacia adentro y no se sale mi perro. Muy contento con la batería de respaldo y el WiFi para abrirlo desde el celular.',
    name: 'Fernando G.',
    meta: 'Chipinque, San Pedro Garza García',
    service: 'Portón ascendente tipo americano',
  },
  {
    quote: 'Me siento muy tranquila desde que instalaron las cámaras. Tienen audio, las veo desde el celular y sé que todo está bien. Excelente servicio, muy buen acabado y nunca han fallado. Visión a color en la noche.',
    name: 'Sra. Eva',
    meta: 'Guadalupe, Nuevo León',
    service: 'Cámaras CCTV con audio',
  },
  {
    quote: 'Me encanta el motor axial de mi portón. Si algún día se dañara, me gustaría poner uno igual.',
    name: 'Sr. Raúl B.',
    meta: 'Escobedo, Nuevo León',
    service: 'Motor axial - residencial',
  },
  {
    quote: 'Muy cómodo en una avenida muy transitada. Fácil de entrar y salir. Me gustó mucho la atención, el servicio y lo amables de los trabajadores.',
    name: 'Sr. Juan G.',
    meta: 'San Nicolás de los Garza',
    service: 'Portón corredizo + motor',
  },
  {
    quote: 'Me siento más cómoda y segura. Mis huéspedes de Airbnb hacen muy buenos comentarios de la entrada siempre iluminada - y no consume nada de energía porque es solar.',
    name: 'Sra. T.',
    meta: 'Vista Hermosa, Monterrey',
    service: 'Luminaria solar + herrería',
  },
  {
    quote: 'Me encantó mi portón. Me gusta hasta cómo se ve con la luz del día y funciona muy bien. Me siento más segura, que abra y cierre rápido sin ningún problema. Ni siquiera hace ruido.',
    name: 'Sra. Erica G.',
    meta: 'Monterrey, NL',
    service: 'Portón residencial',
  },
  // Sr. Ivan G. movido temporalmente al lugar destacado (ver comentario arriba).
  // Cuando se restaure el de Bomberos al destacado, regresar este testimonio aqui:
  // {
  //   quote: 'Está muy cómodo el control remoto para usarlo desde el montacargas, muy seguro y muy rápido. Ayuda a que no se salga el aire acondicionado de la planta y a que el manejo sea cómodo y eficiente.',
  //   name: 'Sr. Iván G.',
  //   meta: 'Zona industrial, Monterrey',
  //   service: 'Portón ascendente industrial',
  // },
];
---
<section id="testimonios">
  <div class="container">
    <div class="section-header">
      <div class="tag">Lo que dicen nuestros clientes</div>
      <h2 class="section-title">Cada instalación,<br>un cliente para siempre</h2>
      <p class="section-sub">Testimonios reales de clientes residenciales, industriales y organizaciones de Monterrey.</p>
    </div>

    <!-- Featured: Antonio (gran tarjeta) -->
    <div class="testi-card featured" style="margin-bottom:1.5rem">
      <div class="testi-stars">★★★★★</div>
      <p class="testi-quote" style="font-size:1.05rem">{featured.quote}</p>
      <div class="testi-author">
        <span class="testi-name">{featured.name}</span>
        <span class="testi-meta">{featured.meta}</span>
        <span class="testi-service">{featured.service}</span>
      </div>
    </div>

    <!-- Highlight industrial (full width). TEMPORAL: ver comentario en frontmatter. -->
    <div class="testi-card" style="background:var(--cream);border-left:4px solid var(--gold);margin-bottom:1.5rem">
      <div class="testi-stars">★★★★★</div>
      <p class="testi-quote">{highlight.quote}</p>
      <div class="testi-author">
        <span class="testi-name">{highlight.name}</span>
        <span class="testi-meta">{highlight.meta}</span>
        <span class="testi-service">{highlight.service}</span>
      </div>
    </div>

    <!-- Grid of individual testimonials -->
    <div class="testimonios-grid">
      {cards.map((t, i) => (
        <div class={`testi-card reveal${i > 0 ? ` reveal-delay-${Math.min(i % 3, 3)}` : ''}`}>
          <div class="testi-stars">★★★★★</div>
          <p class="testi-quote">{t.quote}</p>
          <div class="testi-author">
            <span class="testi-name">{t.name}</span>
            <span class="testi-meta">{t.meta}</span>
            <span class="testi-service">{t.service}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
