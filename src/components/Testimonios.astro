---
// Testimonios reales grabados por clientes de Grupo Spazi Monterrey
const featured = {
  quote: 'Las mismas personas atienden tanto mi empresa como mi casa: motores, camaras, herreria, pintura, control de accesos y cortina de acero. Ya tenemos 8 anos trabajando sin ningun problema.',
  name: 'Antonio',
  meta: 'Monterrey - empresa y residencia',
  service: 'Cliente 8 anos',
};

const bomberos = {
  quote: 'Nos han dado servicio por mas de 7 anos en todas las estaciones. Estamos muy contentos con la rapidez y lo bien hecho del servicio. El motor de cortina de acero nos gusto tanto que quisiéramos uno igual en todas.',
  name: 'Patronato de Bomberos de Nuevo Leon',
  meta: '4 estaciones atendidas',
  service: 'Industrial - 7+ anos',
};

const cards = [
  {
    quote: 'Abre rapido, me siento muy seguro. El control es comodisimo, incluso llegando en moto. No hace ruido, no se ve hacia adentro y no se sale mi perro. Muy contento con la bateria de respaldo y el WiFi para abrirlo desde el celular.',
    name: 'Fernando G.',
    meta: 'Chipinque, San Pedro Garza Garcia',
    service: 'Porton ascendente tipo americano',
  },
  {
    quote: 'Me siento muy tranquila desde que instalaron las camaras. Tienen audio, las veo desde el celular y sé que todo esta bien. Excelente servicio, muy buen acabado y nunca han fallado. Vision a color en la noche.',
    name: 'Sra. Eva',
    meta: 'Guadalupe, Nuevo Leon',
    service: 'Camaras CCTV con audio',
  },
  {
    quote: 'Me encanta el motor axial de mi porton. Si algun dia se danara, me gustaria poner uno igual.',
    name: 'Sr. Raul B.',
    meta: 'Escobedo, Nuevo Leon',
    service: 'Motor axial - residencial',
  },
  {
    quote: 'Muy comodo en una avenida muy transitada. Facil de entrar y salir. Me gusto mucho la atencion, el servicio y lo amables de los trabajadores.',
    name: 'Sr. Juan G.',
    meta: 'San Nicolas de los Garza',
    service: 'Porton corredizo + motor',
  },
  {
    quote: 'Me siento mas comoda y segura. Mis huespedes de Airbnb hacen muy buenos comentarios de la entrada siempre iluminada - y no consume nada de energia porque es solar.',
    name: 'Sra. T.',
    meta: 'Vista Hermosa, Monterrey',
    service: 'Luminaria solar + herreria',
  },
  {
    quote: 'Me encanto mi porton. Me gusta hasta como se ve con la luz del dia, funciona muy bien y ni siquiera hace ruido. Me siento mas segura desde que abre y cierra rapido sin ningun problema.',
    name: 'Sra. Erica G.',
    meta: 'Monterrey, NL',
    service: 'Porton residencial',
  },
  {
    quote: 'El control remoto desde el montacargas es muy comodo. Muy seguro y rapido. Mantiene el aire acondicionado en la planta y hace el manejo mas eficiente.',
    name: 'Sr. Ivan G.',
    meta: 'Zona industrial, Monterrey',
    service: 'Porton ascendente industrial',
  },
];
---
<section id="testimonios">
  <div class="container">
    <div class="section-header">
      <div class="tag">Lo que dicen nuestros clientes</div>
      <h2 class="section-title">Cada instalacion,<br>un cliente para siempre</h2>
      <p class="section-sub">Testimonios reales de clientes residenciales, industriales y organizaciones de Monterrey.</p>
    </div>

    <!-- Featured: Antonio (gran tarjeta) -->
    <div class="testi-card featured" style="margin-bottom:1.5rem">
      <div class="testi-stars">★★★★★</div>
      <p class="testi-quote" style="font-size:1.05rem">{featured.quote}</p>
      <div class="testi-author">
        <span class="testi-name">{featured.name}</span>
        <span class="testi-meta">{featured.meta}</span>
        <span class="testi-service">{featured.service}</span>
      </div>
    </div>

    <!-- Bomberos (full width highlight) -->
    <div class="testi-card" style="background:var(--cream);border-left:4px solid var(--gold);margin-bottom:1.5rem">
      <div class="testi-stars">★★★★★</div>
      <p class="testi-quote">{bomberos.quote}</p>
      <div class="testi-author">
        <span class="testi-name">{bomberos.name}</span>
        <span class="testi-meta">{bomberos.meta}</span>
        <span class="testi-service">{bomberos.service}</span>
      </div>
    </div>

    <!-- Grid of individual testimonials -->
    <div class="testimonios-grid">
      {cards.map((t, i) => (
        <div class={`testi-card reveal${i > 0 ? ` reveal-delay-${Math.min(i % 3, 3)}` : ''}`}>
          <div class="testi-stars">★★★★★</div>
          <p class="testi-quote">{t.quote}</p>
          <div class="testi-author">
            <span class="testi-name">{t.name}</span>
            <span class="testi-meta">{t.meta}</span>
            <span class="testi-service">{t.service}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
