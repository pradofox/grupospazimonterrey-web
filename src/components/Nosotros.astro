---
const trust = [
  {
    icon: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20" height="20"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75"/></svg>`,
    title: 'Red de aliados técnicos especializados',
    desc: 'Herreros, instaladores de cámaras, electricistas y más - coordinados por nosotros.',
  },
  {
    icon: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20" height="20"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: 'Toda el area metropolitana de Monterrey',
    desc: 'San Pedro, Apodaca, Escobedo, Garcia, Santa Catarina, Guadalupe y Monterrey centro.',
  },
  {
    icon: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20" height="20"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Distribuidor oficial con refacciones originales',
    desc: 'Precio de distribuidor, garantía de fabrica y repuestos disponibles en Monterrey.',
  },
  {
    icon: `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20" height="20"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 014.72 12 19.79 19.79 0 011.65 3.37 2 2 0 013.63 1.21h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>`,
    title: 'Soporte post-venta por WhatsApp',
    desc: 'No un número de México que nunca contesta. Soporte real, en Monterrey.',
  },
];
---
<section id="nosotros">
  <div class="container nosotros-grid">
    <div class="nosotros-content">
      <div class="tag" style="border-color:rgba(200,168,75,.5)">Por qué nosotros</div>
      <h2 class="section-title light">Más que una distribuidora -<br><em style="font-style:italic;color:var(--gold)">una aliada de confianza</em></h2>
      <p class="section-sub light" style="margin-top:1rem;margin-left:0">
        En Monterrey nos conocen por resolver. Entran por un portón automático y terminan confiándonos toda la seguridad de su propiedad o planta. Eso no se construye con publicidad - se construye con 14 años de trabajo bien hecho.
      </p>
      <div class="trust-items">
        {trust.map((t, i) => (
          <div class={`trust-item reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
            <div class="trust-icon" set:html={t.icon} />
            <div class="trust-text">
              <strong>{t.title}</strong>
              <span>{t.desc}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="nosotros-cards reveal">
      <div class="nos-card"><div class="num">14</div><div class="label">Años en el mercado</div></div>
      <div class="nos-card"><div class="num">1987</div><div class="label">Fundación Spazi</div></div>
      <div class="nos-card"><div class="num">4+</div><div class="label">Estaciones de bomberos</div></div>
      <div class="nos-card"><div class="num">3</div><div class="label">Segmentos: casa, industria, instaladores</div></div>
    </div>
  </div>
</section>
