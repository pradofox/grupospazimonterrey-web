---
const WA = 'https://wa.me/528114132252?text=Hola%2C%20quiero%20una%20cotizaci%C3%B3n%20sin%20costo';
---
<section id="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <div class="hero-kicker">Distribuidora Oficial · Monterrey, NL</div>
      <h1 class="hero-title">
        Seguridad y automatizacion<br>
        con <em>14 anos de respaldo</em><br>
        en Monterrey
      </h1>
      <p class="hero-desc">
        Portones automaticos, control de accesos, camaras y herreria.
        Atendemos proyectos residenciales, industriales y a instaladores.
        Una sola llamada resuelve todo.
      </p>
      <div class="hero-ctas">
        <a href={WA} target="_blank" rel="noopener" class="btn-wa">
          <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.025.506 3.93 1.395 5.6L0 24l6.585-1.372A11.955 11.955 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.663-.5-5.195-1.375l-.37-.22-3.91.815.83-3.798-.24-.39A9.956 9.956 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
          Cotizar por WhatsApp
        </a>
        <a href="/#servicios" class="btn-secondary">Ver servicios</a>
      </div>
      <div class="hero-stats">
        <div><div class="stat-num">14</div><div class="stat-label">Anos en el mercado</div></div>
        <div><div class="stat-num">1987</div><div class="stat-label">Fundacion Spazi</div></div>
        <div><div class="stat-num">3</div><div class="stat-label">Segmentos atendidos</div></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-img-wrap">
        <img src="/images/spazihome5.jpg" alt="Porton automatico instalado en Monterrey" loading="eager" />
      </div>
      <div class="hero-badge">
        <strong>+7 anos</strong>
        Patronato de Bomberos NL
      </div>
    </div>
  </div>
</section>
