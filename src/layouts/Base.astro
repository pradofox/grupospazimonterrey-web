---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
}

// La canonica se calcula sin el .html que agrega build.format: 'file'.
// Si no se limpia, Astro.url.href apunta a /blog.html, que redirige (307) a
// /blog: Google ve una canonica que no resuelve y deja la pagina sin indexar.
const SITE = 'https://grupospazimonterrey.com';
const cleanPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '')
  .replace(/\/$/, '');

const {
  title,
  description,
  canonical = `${SITE}${cleanPath || '/'}`,
  ogImage = '/og-image.jpg',
  schema,
} = Astro.props;
---
<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0C2554" />
  <link rel="canonical" href={canonical} />

  <!-- Fuentes auto-hospedadas (sin request externo) -->
  <link rel="preload" href="/fonts/manrope-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jbmono-var.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`https://grupospazimonterrey.com${ogImage}`} />
  <meta property="og:site_name" content="Grupo Spazi Monterrey" />
  <meta property="og:locale" content="es_MX" />

  <!-- Twitter/X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://grupospazimonterrey.com${ogImage}`} />

  <!-- Favicons -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="llms" href="/llms.txt" />

  <!-- Schema -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])} />
  )}
</head>
<body>
  <slot />

  <!-- html.js: habilita el reveal solo si hay JS (sin JS todo se ve = bueno para SEO) -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Reveal on scroll -->
  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>

  <!-- Lenis smooth scroll (auto-hospedado, respeta reduced-motion) -->
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      const s = document.createElement('script');
      s.src = '/js/lenis.min.js';
      s.onload = () => {
        // @ts-ignore
        const lenis = new Lenis({ duration: 1.05, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        function raf(time){ lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
        // anchors internos con scroll suave
        document.querySelectorAll('a[href^="/#"], a[href^="#"]').forEach(a => {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href').split('#')[1];
            const t = id && document.getElementById(id);
            if (t) { e.preventDefault(); lenis.scrollTo(t, { offset: -76 }); }
          });
        });
      };
      document.body.appendChild(s);
    }
  </script>
</body>
</html>
